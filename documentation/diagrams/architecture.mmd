%% Mermaid source. Render to architecture.svg; the brief, README and PPT all reuse that one render.
%% Matches prelude.md Section 6 "At a glance" and ADR-0001 service boundaries.
flowchart LR
  subgraph Client
    MIC[Web Speech API\ninterim transcript chunks]
    DASH[React Dashboard\ntranscript · controller lamp · sub-queries · answer versions · citations · cost meter]
  end

  EDGE[nginx edge\nTLS · rate limit · size caps]

  subgraph Gateway["gateway"]
    CTRL[Controller\nWait / Retrieve / No-Retrieval + reason code]
    ORCH[Orchestrator]
    CLAIMS[Claim Graph\nversioned, session-scoped]
    TELE[Telemetry Aggregator\ntrace_id, hash-chain]
    SEC[Security\nHMAC session tokens, PII redaction]
  end

  subgraph ML["ml-service"]
    FEAT[Feature Extractor\nentities · drift · clause boundary]
    EMB[Embed\nbge-small]
    RR[Rerank\nMiniLM cross-encoder]
    NLI[NLI Entailment]
  end

  subgraph VEC["vector-service"]
    ING[Ingestion & Chunking\nsection-aware, [Doc_ID §Section]]
    BM25[BM25 index]
    QD[(Qdrant\ndense HNSW)]
    FUSE[RRF Fusion]
  end

  subgraph AI["ai-service"]
    DECOMP[Decompose\nGPT-5.6 Luna]
    SYNTH[Synthesize\nclaims + citations]
    REPLAY[live / record / replay]
    COST[Cost meter]
  end

  REDIS[(Redis\nsession state, TTL 30 min)]
  EVAL[eval-runner\nstream playback → scorecard]

  MIC -->|chunk stream| EDGE --> CTRL
  CTRL -->|per-chunk features| FEAT
  FEAT --> CTRL
  CTRL -->|Retrieve| ORCH
  CTRL -->|No-Retrieval\ne.g. presentation turn| CLAIMS

  ORCH --> DECOMP
  DECOMP -->|sub-queries, cap 4| ORCH
  ORCH --> EMB
  EMB --> FUSE
  ORCH -->|query| BM25
  BM25 --> FUSE
  EMB -.-> QD
  QD --> FUSE
  FUSE --> RR --> ORCH

  ORCH --> SYNTH
  SYNTH -->|claims + quotes| NLI
  NLI -->|allow-list → quote match → entailment| CLAIMS
  CLAIMS -->|verified / uncertainty| ORCH

  ORCH --> CLAIMS
  CLAIMS <-->|session state, TTL| REDIS
  SEC --- CTRL
  SEC --- CLAIMS

  ORCH --> TELE
  CTRL --> TELE
  NLI --> TELE
  TELE -->|JSONL + Redis stream, hashchained| DASH

  ORCH --> DASH
  CLAIMS --> DASH

  EVAL -.->|replayed streams, no live key| Gateway
  EVAL --> SCORECARD[[evaluation/results/scorecard.md]]

  ING --> BM25
  ING --> QD

  classDef edge fill:#333,color:#fff;
  class EDGE edge;
