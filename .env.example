# Copy to .env and fill in for `live`/`record` modes. `make eval` and
# `make up` (default profile) work with none of these set — see ADR-0007.

OPENAI_API_KEY=

# ai-service: live | record | offline | replay (default: offline — deterministic,
# no API key needed, and records real trajectories to trajectories/ as it runs)
AI_MODE=offline

# ml-service: hash (fast/offline default) | transformer (real bge-small/MiniLM/NLI models)
ML_BACKEND=hash

SESSION_HMAC_SECRET=dev-secret-change-me
SESSION_TTL_SECONDS=1800
RAW_LOGGING=false

DECOMPOSE_MODEL=gpt-5.6-luna
SYNTHESIZE_MODEL=gpt-5.6-luna
